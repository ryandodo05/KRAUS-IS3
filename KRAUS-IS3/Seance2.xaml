<Page x:Class="KRAUS_IS3.Seance2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Séance 2 - Envoi de mail">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FF412C50">
            <TextBlock Text="Séance 2 - Envoi d'un mail"
                       Foreground="White" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="40,20" MaxWidth="450" HorizontalAlignment="Center">

            <TextBlock Text="Votre adresse Email" FontSize="14" Margin="0,10,0,3" Foreground="#FF412C50"/>
            <TextBox x:Name="txtEmailExpediteur" Height="30" Padding="5"/>

            <TextBlock Text="Votre mot de passe (clé d'application)" FontSize="14" Margin="0,10,0,3" Foreground="#FF412C50"/>
            <PasswordBox x:Name="txtPassword" Height="30" Padding="5"/>

            <TextBlock Text="Adresse destinataire" FontSize="14" Margin="0,10,0,3" Foreground="#FF412C50"/>
            <TextBox x:Name="txtEmailDestinataire" Height="30" Padding="5"/>

            <TextBlock Text="Objet" FontSize="14" Margin="0,10,0,3" Foreground="#FF412C50"/>
            <TextBox x:Name="txtObjet" Height="30" Padding="5"/>

            <TextBlock Text="Message" FontSize="14" Margin="0,10,0,3" Foreground="#FF412C50"/>
            <TextBox x:Name="txtMessage" Height="100" Padding="5" 
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

            <Button x:Name="btnEnvoyer" Content="Envoyer" Height="40" Margin="0,20,0,0"
                    Background="#FFAF8BEB" Foreground="White" FontWeight="Bold" FontSize="14"
                    Click="btnEnvoyer_Click" Cursor="Hand"/>

            <TextBlock x:Name="txtStatus" Margin="0,15,0,0" TextWrapping="Wrap"
                       HorizontalAlignment="Center" FontWeight="Bold"/>

        </StackPanel>
    </Grid>
</Page>