<Window x:Class="KRAUS_IS3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menu Principal" Height="450" Width="700"
        MinHeight="650" MinWidth="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#FF412C50">
            <TextBlock Foreground="White" FontSize="20" 
                       HorizontalAlignment="Center" Margin="0,20,0,20" Text="KRAUS IS3"/>

            <Button x:Name="btnSeance2" Content="Séance 2" Height="40" Margin="10,5"
                    Click="btnSeance2_Click" Background="#FFAF8BEB"/>
            <Button x:Name="btnSeance3" Content="Séance 3" Height="40" Margin="10,5"
                    Click="btnSeance3_Click" Background="#FFAF8BEB"/>
            <Button x:Name="btnSeance4" Content="Séance 4" Height="40" Margin="10,5"
                    Click="btnSeance4_Click" Background="#FFAF8BEB"/>
            <Button x:Name="btnSeance5" Content="Séance 5" Height="40" Margin="10,5"
                    Click="btnSeance5_Click" Background="#FFAF8BEB"/>
            <Button x:Name="btnSeance6" Content="Séance 6" Height="40" Margin="10,5"
                    Click="btnSeance6_Click" Background="#FFAF8BEB"/>
            <Button x:Name="btnSeance7" Content="Séance 7" Height="40" Margin="10,5"
                    Click="btnSeance7_Click" Background="#FFAF8BEB"/>
            <Button x:Name="btnSeance8" Content="Séance 8" Height="40" Margin="10,5"
                    Click="btnSeance8_Click" Background="#FFAF8BEB"/>
        </StackPanel>

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>